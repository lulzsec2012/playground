# File Server — Nginx Site 配置模板
# deploy-server.sh 会将其复制到 /etc/nginx/sites-available/fileserver
# 并创建软链到 sites-enabled/

server {
    listen 0.0.0.0:8080;

    # 50GB 上传限制（适配大模型 checkpoint）
    client_max_body_size 50g;
    proxy_request_buffering off;
    proxy_buffering off;
    client_body_timeout 600s;
    send_timeout 600s;

    # 代理到 Filebrowser（Filebrowser 监听 127.0.0.1:8081 不对外暴露）
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 分享文件直链（由 fs-share 命令自动创建）
    # 无密码分享: 直接在 .shares/ 下创建 symlink 即可
    # 密码分享: 通过 shares.d/*.conf 增加 auth_basic 覆盖
    # 限流: 5 req/s, 可突发 10 个
    location /s/ {
        limit_req zone=share burst=10 nodelay;
        alias /data/files/.shares/;
        autoindex off;
    }

    # 动态分享配置（由 fs-share-helper.sh 管理）
    include /etc/nginx/shares.d/*.conf;
}
