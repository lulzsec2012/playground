# ============================================================
# File Server — 客户端配置模板
# 复制为 fileserver.conf 后填入实际值
# ============================================================

# === Tailscale 模式（内网）===
# 当开发机接入 Tailscale 时，通过 HTTP API 直接操作 Filebrowser
FS_HOST="fileserver"       # Tailscale 内网主机名
FS_PORT="8080"             # Nginx 端口
FS_USER="admin"            # Filebrowser 管理员用户名
FS_PASS="your-password"    # Filebrowser 管理员密码

# === SSH 模式（公网）===
# 无 Tailscale 时通过 SSH 操作文件服务器
FS_SSH_HOST="<server-ip>"  # 实际值写入 scripts/data/hosts.cfg 的 ALIYUN_IP  # 服务器公网 IP 或域名
FS_SSH_PORT="22"           # SSH 端口
FS_SSH_USER="lzlu"         # SSH 登录用户名（使用 SSH key 认证）

# === 通用配置 ===
# 工作模式: auto(自动) / tailscale / ssh
FS_MODE="auto"
# 传输速率限制，单位 KB/s，留空不限速（rsync --bwlimit 参数）
FS_BWLIMIT=""
