#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/fs-lib.sh"

usage() {
    cat <<EOF
复制文件服务器上的文件/目录

用法: fs-cp <远程源路径> <远程目标路径>

参数:
  src  远程源路径（相对 /data/files/）
  dst  远程目标路径（相对 /data/files/）

注意: Tailscale 模式下无复制 API，自动通过 SSH 回退完成复制

示例:
  fs-cp /experiments/model.pt /experiments/backup/model.pt
  fs-cp /data/dataset/ /data/dataset-backup/
EOF
    exit 1
}

_fs_load_config || usage
_fs_detect_mode || exit 1

[ $# -lt 2 ] && usage

_fs_remote_copy "$1" "$2"
