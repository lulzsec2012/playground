# ============================================================
# Pesudo 授权服务器配置
# 复制为 .env 后使用
# ============================================================

# AES-256-GCM 主密钥（首次部署时自动生成）
# 如需手动生成: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PESUDO_MASTER_KEY=

# 监听端口
PESUDO_PORT=8643

# 监听地址（0.0.0.0 = 所有接口，包括 tailscale IP）
PESUDO_HOST=0.0.0.0

# Hermes 家目录（用于自动读取 WeChat 凭据）
# 留空则自动探测: ~/.hermes / /root/.hermes
HERMES_HOME=

# Hermes OpenAI API（可选，当 iLink 直连不可用时 fallback）
HERMES_URL=http://localhost:8642/v1
HERMES_API_KEY=

# 管理员 SSH 认证地址（注册时验证身份，留空则不验证）
ALIYUN_SSH_HOST=localhost
ALIYUN_SSH_USER=

# 数据存储
PESUDO_STORE=/opt/pesudo/store.json
PESUDO_LOG=/opt/pesudo/audit.log

# OTP 配置
OTP_LENGTH=6
OTP_EXPIRE_SECONDS=180
RATE_LIMIT_PER_MINUTE=3
