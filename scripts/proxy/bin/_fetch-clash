#!/usr/bin/env bash
# _fetch-clash — Clash 订阅源下载器（内部命令）
#
# 读取 config/sources.list + data/custom-sources.list，下载所有 Clash YAML 源，
# 合并到 data/config.yaml。自动检测可用代理，递归自代理重试失败的源。
#
# 用法: _fetch-clash [--dry-run]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
source "$SCRIPT_DIR/lib/auto-proxy.sh"

MERGE_PY="$SCRIPT_DIR/lib/merge-clash.py"
GEN_PY="$SCRIPT_DIR/lib/generate-config.py"
CONFIGS_DIR="$SCRIPT_DIR/data/chromego_configs"
SOURCES_LIST="$SCRIPT_DIR/config/sources.list"
CUSTOM_LIST="$SCRIPT_DIR/data/custom-sources.list"
OUTPUT_YAML="$SCRIPT_DIR/data/config.yaml"
OUTPUT_JSON="$CONFIGS_DIR/config.json"
TEMPLATE="${TEMPLATE:-$SCRIPT_DIR/config/template.yaml}"
TMPDIR=""
DRY_RUN=false
MAX_RETRY=3

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
info()  { echo -e "${CYAN}$1${NC}"; }
ok()    { echo -e "  ${GREEN}✓${NC} $1"; }
warn()  { echo -e "  ${YELLOW}⚠${NC} $1" >&2; }
err()   { echo -e "  ${RED}✗${NC} $1" >&2; }

usage() {
  echo "用法: $(basename "$0") [--dry-run]"
  echo "从 sources.list + custom-sources.list 下载并合并 Clash 源"
  exit 1
}

cleanup() { rm -rf "$TMPDIR"; }

# 读取所有源 URL（去重）
read_sources() {
  local -n arr="$1"
  arr=()
  [ -f "$SOURCES_LIST" ] && while IFS= read -r line; do
    line="${line%%#*}"  # 去掉行内注释
    line="${line//[[:space:]]/}"
    [ -n "$line" ] || continue
    # 去重
    local dup=false
    for u in "${arr[@]}"; do [ "$u" = "$line" ] && dup=true && break; done
    $dup || arr+=("$line")
  done < "$SOURCES_LIST"
  [ -f "$CUSTOM_LIST" ] && while IFS= read -r line; do
    line="${line%%#*}"
    line="${line//[[:space:]]/}"
    [ -n "$line" ] || continue
    local dup=false
    for u in "${arr[@]}"; do [ "$u" = "$line" ] && dup=true && break; done
    $dup || arr+=("$line")
  done < "$CUSTOM_LIST"
}

# ── 尝试下载单个 URL ──
try_download_url() {
  local url="$1" outfile="$2"
  local name
  name="$(echo "$url" | sed -E 's|https?://[^/]+/||' | sed 's|/raw/|/|' | cut -d'/' -f1-2)"

  if [ -z "${PROXY_LIST:-}" ]; then
    local code
    code="$(curl -sL -o "$outfile" -w "%{http_code}" \
      --connect-timeout 10 --max-time 30 "$url" 2>/dev/null || true)"
    if [ "$code" = "200" ] && [ -s "$outfile" ]; then
      echo "  [${name}] 直连 OK"
      return 0
    fi
    rm -f "$outfile"
    return 1
  fi

  while IFS= read -r proxy; do
    [ -z "$proxy" ] && continue
    local scheme="${proxy%%://*}"
    local addr="${proxy#*://}"
    local code
    code="$(curl -sL -o "$outfile" -w "%{http_code}" \
      --connect-timeout 10 --max-time 30 \
      -x "${scheme}://${addr}" "$url" 2>/dev/null || true)"
    if [ "$code" = "200" ] && [ -s "$outfile" ]; then
      echo "  [${name}] 通过 ${addr} OK"
      return 0
    fi
  done <<< "$PROXY_LIST"

  rm -f "$outfile"
  return 1
}

is_valid_clash_yaml() {
  local file="$1"
  [ -s "$file" ] || return 1
  grep -q '^proxies:' "$file" 2>/dev/null || return 1
  grep -q '^- name:' "$file" 2>/dev/null || return 1
  return 0
}

# ── 部署部分结果（递归重试用） ──
deploy_partial() {
  local src_files=("$@")
  [ ${#src_files[@]} -eq 0 ] && { warn "无源文件，跳过部署"; return 1; }
  info "  部署部分结果 (${#src_files[@]} 个源)..."
  python3 "$MERGE_PY" "$TEMPLATE" "$OUTPUT_YAML" "${src_files[@]}" || { warn "merge-clash.py 失败"; return 1; }
  python3 "$GEN_PY" --proxy-yaml "$OUTPUT_YAML" --configs "$CONFIGS_DIR" --output "$OUTPUT_JSON" || { warn "generate-config.py 失败"; return 1; }
  if command -v systemctl &>/dev/null; then
    sudo systemctl restart sing-box 2>/dev/null || sudo systemctl restart sing-box-chromego 2>/dev/null || true
    sleep 2
  fi
  auto_detect_proxies || true
  [ -z "${PROXY_LIST:-}" ] && { warn "部署后仍无代理，无法继续重试"; return 1; }
  ok "部署完成，可用代理: $(echo "$PROXY_LIST" | wc -l | tr -d ' ') 个"
  return 0
}

main() {
  [[ "${1:-}" = "--dry-run" ]] && DRY_RUN=true
  TMPDIR="$(mktemp -d)"
  trap cleanup EXIT

  [ -f "$TEMPLATE" ] || { err "模板不存在: $TEMPLATE"; return 1; }

  auto_detect_proxies || true
  if [ -n "${PROXY_ADDR:-}" ]; then
    local cnt
    cnt="$(echo "$PROXY_LIST" | sed '/^$/d' | wc -l | tr -d ' ')"
    echo "  代理: $PROXY_ADDR ($cnt 个候选)"
  else
    echo "  直连模式"
  fi

  local SOURCE_URLS=()
  read_sources SOURCE_URLS
  echo "  订阅源: ${#SOURCE_URLS[@]} 个"
  [ ${#SOURCE_URLS[@]} -eq 0 ] && { warn "无可用订阅源"; return 1; }

  # Phase 1: 初始下载
  local DOWNLOADED_FILES=()
  local FAILED_URLS=()
  for url in "${SOURCE_URLS[@]}"; do
    local tmpfile
    tmpfile="$(mktemp "$TMPDIR/src.XXXXXX")"
    if try_download_url "$url" "$tmpfile" && is_valid_clash_yaml "$tmpfile"; then
      ok "下载成功: $url"
      DOWNLOADED_FILES+=("$tmpfile")
    else
      rm -f "$tmpfile"
      err "下载失败: $url"
      FAILED_URLS+=("$url")
    fi
  done
  echo "  初始: ${#DOWNLOADED_FILES[@]} 成功, ${#FAILED_URLS[@]} 失败"

  [ ${#DOWNLOADED_FILES[@]} -eq 0 ] && { warn "全部下载失败"; return 1; }

  # Phase 2: 递归重试
  local retry_round=0
  while [ ${#FAILED_URLS[@]} -gt 0 ] && [ "$retry_round" -lt "$MAX_RETRY" ]; do
    retry_round=$((retry_round + 1))
    echo "  递归重试第 ${retry_round} 轮..."
    deploy_partial "${DOWNLOADED_FILES[@]}" || break
    local new_ok=() new_fail=()
    for url in "${FAILED_URLS[@]}"; do
      local tf; tf="$(mktemp "$TMPDIR/src.XXXXXX")"
      if try_download_url "$url" "$tf" && is_valid_clash_yaml "$tf"; then
        ok "重试成功: $url"
        new_ok+=("$tf")
      else
        rm -f "$tf"; new_fail+=("$url")
      fi
    done
    [ ${#new_ok[@]} -eq 0 ] && { warn "本轮无新下载，停止递归"; FAILED_URLS=("${new_fail[@]}"); break; }
    DOWNLOADED_FILES+=("${new_ok[@]}"); FAILED_URLS=("${new_fail[@]}")
    ok "本轮 ${#new_ok[@]} 个, 剩余 ${#FAILED_URLS[@]} 个"
  done

  [ "$DRY_RUN" = true ] && { echo "DRY RUN，临时文件在 $TMPDIR"; return 0; }

  # Phase 3: 最终合并
  echo "  最终合并..."
  python3 "$MERGE_PY" "$TEMPLATE" "$OUTPUT_YAML" "${DOWNLOADED_FILES[@]}" || { err "merge-clash.py 失败"; return 1; }
  local n; n="$(grep -c '^- name:' "$OUTPUT_YAML" 2>/dev/null || echo 0)"
  ok "合并完成，节点数: $n"
}

main "$@"
