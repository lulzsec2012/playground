#!/usr/bin/env bash
# proxy-deploy — 一键部署完整代理系统
#
# 功能:
#   1. 安装 sing-box（代理引擎）
#   2. 下载 geoip/geosite 规则集（国内分流）
#   3. 下载免费 Clash 订阅源 + ChromeGo 源
#   4. 集成 Mullvad WireGuard（可选，自动检测 data/mullvad/）
#   5. 生成统一 sing-box 配置（免费节点 + Mullvad + 路由规则）
#   6. 安装 Clash Dashboard（Web 管理面板）
#   7. 启动 systemd 服务 / Docker 入口
#   8. 安装 cron 定时更新订阅
#
# 用法:
#   proxy-deploy                           # 完整部署
#   proxy-deploy --skip-fetch              # 跳过订阅更新
#   proxy-deploy --skip-mullvad            # 跳过 Mullvad 集成
#   proxy-deploy --dashboard [yacd|metacubexd|none]  # Dashboard 选择 (默认 metacubexd)
#   proxy-deploy --status                  # 查看当前代理状态
#   proxy-deploy --restart                 # 重启代理服务
#   proxy-deploy --stop                    # 停止代理服务
#   proxy-deploy --logs                    # 查看日志
#   proxy-deploy --install-cron            # 只安装 cron
#   proxy-deploy --remove-cron             # 移除 cron
#   proxy-deploy --dry-run                 # 只生成配置，不部署
#   proxy-deploy -h
#
# 环境变量:
#   LISTEN         — 监听地址 (默认: 0.0.0.0)
#   PORT           — 代理端口 (默认: 1080)
#   DASHBOARD_PORT — Dashboard 端口 (默认: 9090)
#
# 远程使用 (Tailscale):
#   部署后远程电脑设置代理 socks5://<tailscale-ip>:1080
#   或通过 Dashboard 切换路由: http://<tailscale-ip>:9090

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
LIB_DIR="$SCRIPT_DIR/lib"
BIN_DIR="$SCRIPT_DIR/bin"
DATA_DIR="$SCRIPT_DIR/data"
CONFIGS_DIR="$DATA_DIR/chromego_configs"
MULLVAD_DIR="$DATA_DIR/mullvad"
MULLVAD_OUTBOUNDS="$DATA_DIR/mullvad-outbounds.json"

CONFIG_JSON="$DATA_DIR/config.json"
YAML="$DATA_DIR/config.yaml"
GEN_PY="$LIB_DIR/generate-config.py"
MULLVAD_CONVERTER="$LIB_DIR/mullvad-wg-to-singbox.py"

SINGBOX_BIN="${SINGBOX_BIN:-sing-box}"
LISTEN="${LISTEN:-0.0.0.0}"
PORT="${PORT:-1080}"
DASHBOARD_PORT="${DASHBOARD_PORT:-9090}"
SERVICE_NAME="sing-box-proxy"
RULESET_DIR="$DATA_DIR/rule-set"
DASHBOARD_DIR="$DATA_DIR/ui"
CACHE_FILE="$DATA_DIR/cache.db"
# 相对路径（相对于 DATA_DIR，给 --directory 用）
REL_RULESET_DIR="rule-set"
REL_CACHE_FILE="cache.db"

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; CYAN='\033[0;36m'; BLUE='\033[0;34m'; NC='\033[0m'
info()  { echo -e "${CYAN}$*${NC}"; }
ok()    { echo -e "  ${GREEN}✓${NC} $*"; }
warn()  { echo -e "  ${YELLOW}⚠${NC} $*" >&2; }
err()   { echo -e "  ${RED}✗${NC} $*" >&2; }
header(){ echo -e "\n${BLUE}━━━ $* ━━━${NC}"; }

# ═══════════════════════════════════════════
# 辅助函数
# ═══════════════════════════════════════════

install_cron() {
  local cron_cmd="*/30 * * * * cd $SCRIPT_DIR && bash bin/_update-sources >/dev/null 2>&1"
  if crontab -l 2>/dev/null | grep -qF "bin/_update-sources"; then
    ok "cron 已存在"; return
  fi
  (crontab -l 2>/dev/null || true; echo "$cron_cmd") | crontab -
  ok "cron 已安装 (每 30 分钟更新订阅)"
}

remove_cron() {
  crontab -l 2>/dev/null | grep -vF "bin/_update-sources" | crontab - || true
  ok "cron 已移除"
}

show_cron() {
  if crontab -l 2>/dev/null | grep -qF "bin/_update-sources"; then
    echo "cron: 已安装"; crontab -l 2>/dev/null | grep "bin/_update-sources"
  else
    echo "cron: 未安装"
  fi
}

ts_ip() {
  tailscale ip -4 2>/dev/null || echo ""
}

get_ts_ip() {
  local ip
  ip=$(ts_ip)
  echo "${ip:-未知}"
}

# ═══════════════════════════════════════════
# Step 0: 状态查看
# ═══════════════════════════════════════════

cmd_status() {
  echo ""
  echo "╔══════════════════════════════════════╗"
  echo "║       代理系统运行状态               ║"
  echo "╚══════════════════════════════════════╝"
  echo ""

  # sing-box 状态
  if command -v "$SINGBOX_BIN" &>/dev/null; then
    local ver
    ver=$("$SINGBOX_BIN" version 2>&1 | head -1)
    echo "  sing-box:  ${GREEN}已安装${NC}  ($ver)"
  else
    echo "  sing-box:  ${RED}未安装${NC}"
  fi

  # 进程状态
  if pgrep -x "$SINGBOX_BIN" >/dev/null 2>&1; then
    local pid mem
    pid=$(pgrep -x "$SINGBOX_BIN" | head -1)
    mem=$(ps -o rss= -p "$pid" 2>/dev/null | awk '{printf "%.0f MB", $1/1024}')
    echo "  进程:      ${GREEN}运行中${NC}  (PID $pid, RSS $mem)"
  else
    echo "  进程:      ${RED}未运行${NC}"
  fi

  # systemd 服务
  if systemctl is-active "$SERVICE_NAME" &>/dev/null 2>&1; then
    echo "  服务:      ${GREEN}活跃${NC}  ($SERVICE_NAME)"
    local uptime
    uptime=$(systemctl show "$SERVICE_NAME" -p ActiveEnterTimestamp --value 2>/dev/null || echo "")
    [[ -n "$uptime" ]] && echo "  启动时间:  $uptime"
  else
    echo "  服务:      ${RED}未运行${NC}"
  fi

  # 监听端口
  echo ""
  echo "  ── 端口监听 ──"
  if ss -tlnp 2>/dev/null | grep -q ":$PORT "; then
    echo "  代理端口 ${PORT}:  ${GREEN}监听中${NC} (SOCKS5+HTTP)"
  else
    echo "  代理端口 ${PORT}:  ${RED}未监听${NC}"
  fi
  if ss -tlnp 2>/dev/null | grep -q ":$DASHBOARD_PORT "; then
    echo "  Dashboard ${DASHBOARD_PORT}: ${GREEN}监听中${NC} (Clash API)"
  else
    echo "  Dashboard ${DASHBOARD_PORT}: ${RED}未监听${NC}"
  fi

  # 节点统计
  echo ""
  echo "  ── 节点统计 ──"
  if [[ -f "$CONFIG_JSON" ]]; then
    python3 -c "
import json
with open('$CONFIG_JSON') as f:
    c = json.load(f)
obs = c.get('outbounds', [])
proxy_types = {'vless','vmess','trojan','shadowsocks','hysteria','hysteria2','tuic','wireguard','socks','http'}
proxy_nodes = [o for o in obs if isinstance(o, dict) and o.get('type') in proxy_types]
mullvad_nodes = [o for o in proxy_nodes if o['type'] == 'wireguard']
free_nodes = [o for o in proxy_nodes if o['type'] != 'wireguard']
print(f'  免费节点:   {len(free_nodes)}')
print(f'  Mullvad:    {len(mullvad_nodes)} (WireGuard)')
print(f'  总节点数:   {len(proxy_nodes)}')
" 2>/dev/null || echo "  配置未生成"
  else
    echo "  配置未生成 (首次部署会自动生成)"
  fi

  # 路由分组
  if [[ -f "$CONFIG_JSON" ]]; then
    echo ""
    echo "  ── 路由分组 ──"
    python3 -c "
import json
with open('$CONFIG_JSON') as f:
    c = json.load(f)
selectors = [o for o in c.get('outbounds', []) if isinstance(o, dict) and o.get('type') == 'selector']
for s in selectors:
    default = s.get('default', '-')
    print(f'  {s[\"tag\"]:30s} default={default}')
" 2>/dev/null
  fi

  # Dashboard
  local tip
  tip=$(get_ts_ip)
  echo ""
  echo "  ── 管理入口 ──"
  echo "  Dashboard: http://127.0.0.1:$DASHBOARD_PORT/ui"
  [[ "$tip" != "未知" ]] && echo "  Tailscale: http://$tip:$DASHBOARD_PORT/ui"
  echo "  代理:      socks5://127.0.0.1:$PORT"
  [[ "$tip" != "未知" ]] && echo "            socks5://$tip:$PORT"
  echo ""

  # 出口 IP
  if [[ -x "$BIN_DIR/proxy-test" ]] && pgrep -x "$SINGBOX_BIN" >/dev/null 2>&1; then
    echo "  ── 出口 IP (通过代理) ──"
    curl -sS --max-time 5 -x "socks5h://127.0.0.1:$PORT" \
      "https://api.ipify.org?format=json" 2>/dev/null | python3 -c "
import sys,json
try: d=json.load(sys.stdin); print(f'  出口 IP: {d.get(\"ip\",\"?\")}')
except: pass
" 2>/dev/null || echo "  出口 IP: 查询超时"
  fi
  echo ""
}

# ═══════════════════════════════════════════
# Step 1: 前置检测 + 安装 sing-box
# ═══════════════════════════════════════════

check_prereqs() {
  header "前置检测"
  command -v python3 &>/dev/null || { err "需要 python3"; exit 1; }
  command -v curl &>/dev/null    || { err "需要 curl";   exit 1; }
  python3 -c "import yaml" 2>/dev/null || {
    warn "未安装 PyYAML，尝试安装..."
    pip3 install pyyaml -q 2>/dev/null || {
      err "安装 PyYAML 失败: pip3 install pyyaml"
      exit 1
    }
  }
  mkdir -p "$CONFIGS_DIR" "$MULLVAD_DIR"
  mkdir -p "$RULESET_DIR" 2>/dev/null || warn "无法创建 $RULESET_DIR（需要 sudo？）"
  mkdir -p "$DASHBOARD_DIR" 2>/dev/null || warn "无法创建 $DASHBOARD_DIR（需要 sudo？）"
  ok "环境就绪"
}

install_singbox() {
  header "安装 sing-box"
  if command -v "$SINGBOX_BIN" &>/dev/null; then
    ok "sing-box 已安装: $($SINGBOX_BIN version 2>&1 | head -1)"
    return 0
  fi

  # 通过 GitHub release 下载预编译二进制 (通用 amd64)
  local version="1.11.6"
  local arch="linux-amd64"
  local tmp_dir="/tmp/sing-box-install"
  local urls=(
    "https://github.com/SagerNet/sing-box/releases/download/v${version}/sing-box-${version}-${arch}.tar.gz"
    "https://gh-proxy.com/https://github.com/SagerNet/sing-box/releases/download/v${version}/sing-box-${version}-${arch}.tar.gz"
    "https://ghproxy.net/https://github.com/SagerNet/sing-box/releases/download/v${version}/sing-box-${version}-${arch}.tar.gz"
    "https://ghproxy.com/https://github.com/SagerNet/sing-box/releases/download/v${version}/sing-box-${version}-${arch}.tar.gz"
  )
  # 环境变量可覆盖下载 URL（如使用内部镜像）
  if [[ -n "${SINGBOX_DOWNLOAD_URL:-}" ]]; then
    urls=("$SINGBOX_DOWNLOAD_URL")
  fi

  info "下载 sing-box v${version}..."
  mkdir -p "$tmp_dir"
  local downloaded=false
  for url in "${urls[@]}"; do
    info "  尝试: ${url}"
    if curl -fsSL --max-time 120 --connect-timeout 10 \
      -o "$tmp_dir/sing-box.tar.gz" "$url" 2>/dev/null; then
      downloaded=true
      break
    fi
    warn "  失败，尝试下一个镜像..."
  done

  if ! $downloaded; then
    err "下载失败，请手动下载后放入 ~/.local/bin/:"
    err "  https://github.com/SagerNet/sing-box/releases"
    rm -rf "$tmp_dir"
    exit 1
  fi

  tar -xzf "$tmp_dir/sing-box.tar.gz" -C "$tmp_dir"
  local bin_path
  bin_path=$(find "$tmp_dir" -name "sing-box" -type f 2>/dev/null | head -1)
  if [[ -z "$bin_path" ]]; then
    err "解压后找不到 sing-box 二进制"
    rm -rf "$tmp_dir"
    exit 1
  fi

  chmod +x "$bin_path"
  # 优先安装到用户本地 bin
  local install_dir="${HOME}/.local/bin"
  mkdir -p "$install_dir"
  cp "$bin_path" "$install_dir/sing-box"
  rm -rf "$tmp_dir"

  # 更新 PATH
  export PATH="$install_dir:$PATH"

  if command -v "$SINGBOX_BIN" &>/dev/null; then
    ok "sing-box 已安装: $($SINGBOX_BIN version 2>&1 | head -1)"
  else
    err "安装失败，请手动安装: https://github.com/SagerNet/sing-box/releases"
    exit 1
  fi
}

# ═══════════════════════════════════════════
# Step 2: 规则集
# ═══════════════════════════════════════════

setup_rulesets() {
  header "规则集"
  if [[ -f "$RULESET_DIR/geoip-cn.srs" ]] && [[ -f "$RULESET_DIR/geosite-cn.srs" ]]; then
    ok "规则集已存在 ($(du -sh "$RULESET_DIR" | cut -f1))"
    return 0
  fi

  info "下载 geoip 数据库..."
  local geoip_db="/tmp/geoip.db" geosite_db="/tmp/geosite.db"
  local geoip_urls=(
    "https://github.com/SagerNet/sing-geoip/releases/latest/download/geoip.db"
    "https://gh-proxy.com/https://github.com/SagerNet/sing-geoip/releases/latest/download/geoip.db"
    "https://ghproxy.net/https://github.com/SagerNet/sing-geoip/releases/latest/download/geoip.db"
  )
  if [[ -n "${SINGBOX_GEOIP_URL:-}" ]]; then
    geoip_urls=("$SINGBOX_GEOIP_URL")
  fi

  local ok=false
  for url in "${geoip_urls[@]}"; do
    if curl -fsSL --max-time 60 --connect-timeout 10 -o "$geoip_db" "$url" 2>/dev/null; then
      ok=true; break
    fi
  done
  if ! $ok; then
    warn "geoip.db 下载失败，跳过规则集"
    return 1
  fi

  info "下载 geosite 数据库..."
  local geosite_urls=(
    "https://github.com/SagerNet/sing-geosite/releases/latest/download/geosite.db"
    "https://gh-proxy.com/https://github.com/SagerNet/sing-geosite/releases/latest/download/geosite.db"
    "https://ghproxy.net/https://github.com/SagerNet/sing-geosite/releases/latest/download/geosite.db"
  )
  if [[ -n "${SINGBOX_GEOSITE_URL:-}" ]]; then
    geosite_urls=("$SINGBOX_GEOSITE_URL")
  fi

  ok=false
  for url in "${geosite_urls[@]}"; do
    if curl -fsSL --max-time 60 --connect-timeout 10 -o "$geosite_db" "$url" 2>/dev/null; then
      ok=true; break
    fi
  done
  if ! $ok; then
    warn "geosite.db 下载失败，跳过规则集"
    return 1
  fi

  info "导出规则集..."
  "$SINGBOX_BIN" geoip export cn -f "$geoip_db" -o "$RULESET_DIR/geoip-cn.srs" 2>/dev/null
  "$SINGBOX_BIN" geosite export cn -f "$geosite_db" -o "$RULESET_DIR/geosite-cn.srs" 2>/dev/null
  rm -f "$geoip_db" "$geosite_db"

  if [[ -f "$RULESET_DIR/geoip-cn.srs" ]] && [[ -f "$RULESET_DIR/geosite-cn.srs" ]]; then
    ok "规则集已生成 ($(du -sh "$RULESET_DIR" | cut -f1))"
  else
    warn "规则集生成失败，国内分流可能不准确"
  fi
}

# ═══════════════════════════════════════════
# Step 3: 订阅更新
# ═══════════════════════════════════════════

update_subscriptions() {
  header "订阅更新"

  info "下载 ChromeGo 源..."
  bash "$LIB_DIR/source-chromego.sh" 2>&1 | tail -3 || true

  info "下载免费 Clash 订阅..."
  if [[ -x "$BIN_DIR/_fetch-clash" ]]; then
    bash "$BIN_DIR/_fetch-clash" 2>&1 | tail -3 || true
  fi
  if [[ -x "$BIN_DIR/_update-sources" ]]; then
    bash "$BIN_DIR/_update-sources" 2>&1 | tail -3 || true
  fi
}

# ═══════════════════════════════════════════
# Step 4: Mullvad 集成
# ═══════════════════════════════════════════

integrate_mullvad() {
  header "Mullvad 集成"

  local conf_count=0
  if [[ -d "$MULLVAD_DIR" ]]; then
    conf_count=$(find "$MULLVAD_DIR" -name '*.conf' ! -name '*demo*' | wc -l)
  fi

  if [[ "$conf_count" -eq 0 ]]; then
    info "未检测到 Mullvad WireGuard 配置，跳过"
    info "  如需开启: 将 .conf 文件放入 $MULLVAD_DIR/"
    rm -f "$MULLVAD_OUTBOUNDS"
    return 0
  fi

  info "检测到 $conf_count 个 Mullvad 配置，正在转换..."
  python3 "$MULLVAD_CONVERTER" \
    --dir "$MULLVAD_DIR" \
    --output "$MULLVAD_OUTBOUNDS" \
    --groups --pretty

  if [[ ! -f "$MULLVAD_OUTBOUNDS" ]]; then
    warn "Mullvad 转换失败"
    return 0
  fi

  local count
  count=$(python3 -c "import json; d=json.load(open('$MULLVAD_OUTBOUNDS')); print(len(d['outbounds']))" 2>/dev/null || echo 0)
  ok "Mullvad: $count 个 WireGuard 出口节点"
}

# ═══════════════════════════════════════════
# Step 5: 生成 sing-box 配置
# ═══════════════════════════════════════════

generate_config() {
  header "生成配置"

  # 5a. 使用 generate-config.py 生成基础配置（免费节点 + 路由）
  info "生成免费节点配置..."
  # 使用相对路径（启动时通过 --directory 指定 data 目录）
  export SINGBOX_RULESET_DIR="$REL_RULESET_DIR"
  export SINGBOX_CACHE_FILE="$REL_CACHE_FILE"
  local py_cmd="python3 \"$GEN_PY\""
  py_cmd+=" --output \"$CONFIG_JSON\""
  py_cmd+=" --listen \"$LISTEN\""
  py_cmd+=" --port $PORT"
  py_cmd+=" --dashboard-port $DASHBOARD_PORT"
  if [[ -f "$YAML" ]]; then
    py_cmd+=" --proxy-yaml \"$YAML\""
  fi

  eval "$py_cmd" || true

  # 5b. 如果免费节点为 0 且没有 Mullvad
  if [[ ! -f "$CONFIG_JSON" ]] && [[ ! -f "$MULLVAD_OUTBOUNDS" ]]; then
    warn "无可用节点（首次部署正常，后续 cron 会自动补充）"
    return 0
  fi

  # 5c. 注入 Mullvad 出站
  if [[ -f "$MULLVAD_OUTBOUNDS" ]]; then
    info "注入 Mullvad 到配置..."

    # 如果基础配置未生成（免费节点为 0），创建最小骨架
    if [[ ! -f "$CONFIG_JSON" ]]; then
      python3 -c "
import json
cfg = {
    'log': {'level': 'info'},
    'inbounds': [{
        'type': 'mixed',
        'tag': 'mixed-in',
        'listen': '$LISTEN',
        'listen_port': $PORT,
    }],
    'outbounds': [
        {'type': 'direct', 'tag': 'direct'},
        {'type': 'block', 'tag': 'block'},
    ],
    'route': {
        'rules': [],
        'final': 'direct',
        'auto_detect_interface': True,
    },
    'experimental': {
        'cache_file': {
            'enabled': True,
            'path': '$REL_CACHE_FILE',
        },
        'clash_api': {
            'external_controller': '$LISTEN:$DASHBOARD_PORT',
            'external_ui': 'ui',
        },
    },
}
with open('$CONFIG_JSON', 'w') as f:
    json.dump(cfg, f, indent=2)
print('  已创建最小骨架配置')
"
    fi

    # 注入 Mullvad outbound + group
    python3 -c "
import json

config_path = '$CONFIG_JSON'
mullvad_path = '$MULLVAD_OUTBOUNDS'

with open(config_path) as f:
    config = json.load(f)
with open(mullvad_path) as f:
    mullvad = json.load(f)

mullvad_obs = mullvad.get('outbounds', [])
mullvad_groups = mullvad.get('group_outbounds', [])
meta_keys = {'_region_label', '_country', '_dns_hint'}
mullvad_selector = 'mullvad-selector'

existing_tags = {ob['tag'] for ob in config.get('outbounds', [])}
new_count = 0
for ob in mullvad_obs:
    if ob['tag'] not in existing_tags:
        for k in meta_keys:
            ob.pop(k, None)
        config['outbounds'].append(ob)
        new_count += 1

for ob in mullvad_groups:
    config['outbounds'].append(ob)

# 将 Mullvad 加入非 Mullvad selector 的选项
for ob in config.get('outbounds', []):
    if ob.get('type') == 'selector' and 'outbounds' in ob:
        if ob['tag'] != mullvad_selector and mullvad_selector not in ob['outbounds']:
            ob['outbounds'].insert(1, mullvad_selector)

with open(config_path, 'w') as f:
    json.dump(config, f, indent=2, ensure_ascii=False)

count = len(mullvad_obs)
group_count = len(mullvad_groups)
print(f'  注入 {count} 个 Mullvad 节点, {group_count} 个路由组')
"

    rm -f "$MULLVAD_OUTBOUNDS"
  fi

  # 5d. 统计节点数
  local n
  n=$(python3 -c "
import json
with open('$CONFIG_JSON') as f:
    c = json.load(f)
obs = c.get('outbounds', [])
types = {'vless','vmess','trojan','shadowsocks','hysteria','hysteria2','tuic','wireguard'}
print(sum(1 for o in obs if isinstance(o, dict) and o.get('type') in types))
" 2>/dev/null || echo 0)

  if [[ "$n" -gt 0 ]]; then
    ok "配置生成完成，节点数: $n"
  else
    warn "配置无可用节点（首次部署正常，cron 后续会补充）"
  fi
}

# ═══════════════════════════════════════════
# Step 6: 安装 Dashboard
# ═══════════════════════════════════════════

install_dashboard() {
  local style="${1:-metacubexd}"
  [[ "$style" == "none" ]] && { info "跳过 Dashboard 安装"; return 0; }

  header "Dashboard"

  local url=""
  case "$style" in
    metacubexd)
      # metacubexd — 现代 Clash Dashboard
      url="https://github.com/MetaCubeX/metacubexd/releases/latest/download/compressed-dist.tgz"
      ;;
    yacd)
      # Yacd — 经典 Clash Dashboard
      url="https://github.com/MetaCubeX/Yacd-meta/gh-pages/download/compressed-dist.tgz"
      ;;
    *)
      warn "未知 Dashboard 风格: $style，使用 metacubexd"
      url="https://github.com/MetaCubeX/metacubexd/releases/latest/download/compressed-dist.tgz"
      ;;
  esac

  if [[ -f "$DASHBOARD_DIR/index.html" ]]; then
    ok "Dashboard 已安装"
    return 0
  fi

  info "下载 $style 面板..."
  mkdir -p "$DASHBOARD_DIR" 2>/dev/null || {
    warn "无法创建 $DASHBOARD_DIR，跳过安装"
    return 1
  }

  # 多镜像下载
  local dash_urls=("$url")
  if [[ "$style" == "metacubexd" ]]; then
    dash_urls+=(
      "https://gh-proxy.com/https://github.com/MetaCubeX/metacubexd/releases/latest/download/compressed-dist.tgz"
      "https://ghproxy.net/https://github.com/MetaCubeX/metacubexd/releases/latest/download/compressed-dist.tgz"
    )
  fi
  if [[ -n "${DASHBOARD_DOWNLOAD_URL:-}" ]]; then
    dash_urls=("$DASHBOARD_DOWNLOAD_URL")
  fi

  local downloaded=false
  for durl in "${dash_urls[@]}"; do
    if curl -fsSL --max-time 120 --connect-timeout 10 \
      -o /tmp/dashboard.tgz "$durl" 2>/dev/null; then
      downloaded=true
      break
    fi
  done

  if ! $downloaded; then
    warn "Dashboard 下载失败，可稍后手动安装:"
    warn "  curl -fsSL '$url' | tar -xz -C $DASHBOARD_DIR"
    return 1
  fi

  tar -xzf /tmp/dashboard.tgz -C "$DASHBOARD_DIR" 2>/dev/null || {
    # 尝试直接解压到子目录
    mkdir -p /tmp/dash-extract
    tar -xzf /tmp/dashboard.tgz -C /tmp/dash-extract 2>/dev/null
    cp -r /tmp/dash-extract/*/* "$DASHBOARD_DIR/" 2>/dev/null || true
    rm -rf /tmp/dash-extract
  }
  rm -f /tmp/dashboard.tgz

  if [[ -f "$DASHBOARD_DIR/index.html" ]]; then
    ok "Dashboard 已安装: metacubexd"
  else
    warn "Dashboard 解压可能不完整，检查: $DASHBOARD_DIR/"
  fi
}

# ═══════════════════════════════════════════
# Step 7: 部署服务
# ═══════════════════════════════════════════

deploy_service() {
  header "部署服务"

  [[ -f "$CONFIG_JSON" ]] || { warn "配置不存在，跳过部署"; return 1; }

  # 验证配置
  if command -v "$SINGBOX_BIN" &>/dev/null; then
    if "$SINGBOX_BIN" check -c "$CONFIG_JSON" &>/dev/null; then
      ok "配置文件验证通过"
    else
      warn "配置文件验证警告:"
      "$SINGBOX_BIN" check -c "$CONFIG_JSON" 2>&1 || true
    fi
  fi

  # systemd 环境
  if command -v systemctl &>/dev/null && [[ "$(cat /proc/1/comm 2>/dev/null)" = "systemd" ]]; then
    local service_file="/etc/systemd/system/${SERVICE_NAME}.service"
    if [[ ! -f "$service_file" ]]; then
      info "创建 systemd 服务..."
      sudo tee "$service_file" >/dev/null <<SERVICE
[Unit]
Description=Proxy Service (sing-box) — Free Nodes + Mullvad
After=network.target

[Service]
Type=simple
Environment=SINGBOX_RULESET_DIR=$RULESET_DIR
Environment=SINGBOX_CACHE_FILE=$CACHE_FILE
    ExecStart=$SINGBOX_BIN run -c $CONFIG_JSON --directory $DATA_DIR
Restart=on-failure
RestartSec=10
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
SERVICE
      sudo systemctl daemon-reload
      sudo systemctl enable "$SERVICE_NAME"
    fi

    sudo systemctl stop "$SERVICE_NAME" 2>/dev/null || true
    sleep 1
    sudo systemctl start "$SERVICE_NAME" || {
      warn "systemctl 启动失败，尝试直接启动..."
      direct_start
      return
    }
    ok "sing-box systemd 服务已启动 ($SERVICE_NAME)"

  # Docker 容器环境
  elif [[ -f "/.dockerenv" ]]; then
    direct_start
    setup_docker_autostart

  # 其他环境
  else
    direct_start
  fi
}

direct_start() {
  pkill "$SINGBOX_BIN" 2>/dev/null || true
  sleep 1

  nohup "$SINGBOX_BIN" run -c "$CONFIG_JSON" --directory "$DATA_DIR" \
    >/tmp/singbox.log 2>&1 &
  local pid=$!
  sleep 3

  if kill -0 "$pid" 2>/dev/null; then
    ok "sing-box 已启动 (PID $pid)"
  else
    err "sing-box 启动失败，日志:"
    tail -5 /tmp/singbox.log 2>/dev/null || true
    return 1
  fi
}

setup_docker_autostart() {
  local start_script="/etc/sing-box-start.sh"
  if [[ -f "$start_script" ]]; then
    ok "容器启动脚本已存在"
    return 0
  fi

  info "创建容器自启脚本..."
  cat > "$start_script" <<SCRIPT
#!/usr/bin/env bash
[ -f "$CONFIG_JSON" ] || exit 0
nohup ${SINGBOX_BIN} run -c $CONFIG_JSON --directory $DATA_DIR >/tmp/singbox.log 2>&1 &
SCRIPT
  chmod +x "$start_script"

  for rc in /root/.bashrc /home/*/.bashrc; do
    [[ -f "$rc" ]] || continue
    if ! grep -qF "sing-box-start" "$rc" 2>/dev/null; then
      echo "[ -x /etc/sing-box-start.sh ] && /etc/sing-box-start.sh 2>/dev/null || true" >> "$rc"
    fi
  done
  ok "容器自动启动已配置"
}

# ═══════════════════════════════════════════
# Main
# ═══════════════════════════════════════════

main() {
  local skip_fetch=false
  local skip_mullvad=false
  local dashboard_style="metacubexd"
  local dry_run=false

  # 处理快捷命令
  case "${1:-}" in
    -h|--help)
      sed -n '2,28p' "$0" | sed 's/^#//; s/^ //'
      exit 0
      ;;
    --status)   cmd_status; exit 0 ;;
    --restart)  systemctl restart "$SERVICE_NAME" 2>/dev/null && ok "已重启" || direct_start; exit 0 ;;
    --stop)     systemctl stop "$SERVICE_NAME" 2>/dev/null || pkill "$SINGBOX_BIN" 2>/dev/null; ok "已停止"; exit 0 ;;
    --logs)     journalctl -u "$SERVICE_NAME" -n 50 --no-pager 2>/dev/null || tail -50 /tmp/singbox.log 2>/dev/null || echo "无日志"; exit 0 ;;
    --install-cron) install_cron; exit 0 ;;
    --remove-cron) remove_cron; exit 0 ;;
    --show-cron) show_cron; exit 0 ;;
  esac

  # 解析参数
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --skip-fetch) skip_fetch=true ;;
      --skip-mullvad) skip_mullvad=true ;;
      --dashboard) shift; dashboard_style="${1:-metacubexd}" ;;
      --dry-run) dry_run=true ;;
      *) warn "未知参数: $1"; exit 1 ;;
    esac
    shift
  done

  echo ""
  echo "╔══════════════════════════════════════════════╗"
  echo "║       proxy-deploy — 一键代理部署            ║"
  echo "║       免费节点 + Mullvad + 路由管理          ║"
  echo "╚══════════════════════════════════════════════╝"
  echo ""
  echo "  代理端口: $LISTEN:$PORT"
  echo "  Dashboard: $LISTEN:$DASHBOARD_PORT"
  echo "  Dashboard 风格: $dashboard_style"
  local ts; ts=$(get_ts_ip)
  [[ "$ts" != "未知" ]] && echo "  Tailscale: $ts"
  echo ""

  check_prereqs

  if $dry_run; then
    # Dry-run: 只生成配置，不装软件
    info "Dry-run 模式 — 跳过安装和环境准备"
    $skip_fetch || warn "使用 --skip-fetch 跳过订阅下载"
    $skip_mullvad || integrate_mullvad
    generate_config
    ok "Dry-run 完成"
    echo ""
    echo "  配置文件: $CONFIG_JSON"
    echo "  完整部署: proxy-deploy"
    exit 0
  fi

  install_singbox
  setup_rulesets
  $skip_fetch || update_subscriptions
  $skip_mullvad || integrate_mullvad

  generate_config || exit 1

  install_dashboard "$dashboard_style"
  deploy_service

  # 自动安装 cron（systemd 环境）
  if command -v systemctl &>/dev/null; then
    install_cron
  fi

  # 完成提示
  local tip
  tip=$(get_ts_ip)
  echo ""
  echo "╔══════════════════════════════════════════════╗"
  echo "║          部署完成                           ║"
  echo "╚══════════════════════════════════════════════╝"
  echo ""
  echo "  本地代理:"
  echo "    socks5://127.0.0.1:$PORT"
  echo "    http://127.0.0.1:$PORT"
  echo ""
  echo "  远程使用 (Tailscale):"
  if [[ "$tip" != "未知" ]]; then
    echo "    socks5://$tip:$PORT"
    echo "    http://$tip:$PORT"
  fi
  echo ""
  echo "  管理面板:"
  echo "    http://127.0.0.1:$DASHBOARD_PORT/ui"
  [[ "$tip" != "未知" ]] && echo "    http://$tip:$DASHBOARD_PORT/ui"
  echo ""
  echo "  常用命令:"
  echo "    proxy-deploy --status     # 查看状态"
  echo "    proxy-deploy --restart    # 重启"
  echo "    proxy-deploy --stop       # 停止"
  echo "    proxy-deploy --logs       # 查看日志"
  echo ""
  echo "  测试: curl -x socks5h://127.0.0.1:$PORT https://www.google.com"
  echo ""
}

main "$@"
