#!/usr/bin/env bash
# proxy-deploy — 一键部署代理服务（systemd + Docker 容器均支持）
#
# 支持:
#   - systemd 环境: 注册系统服务，开机自启
#   - Docker 容器:  创建 /etc/sing-box-start.sh 入口脚本
#   - 自动生成 geoip/geosite 规则集
#   - 自动下载 ChromeGo + Clash 订阅
#   - 自动安装 cron（systemd 环境）
#
# 用法:
#   proxy-deploy                              # 完整部署
#   proxy-deploy --install-cron               # 只安装 cron
#   proxy-deploy --remove-cron                # 移除 cron
#   proxy-deploy --show-cron                  # 查看 cron 状态
#   proxy-deploy -h                           # 帮助

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/auto-proxy.sh
source "$SCRIPT_DIR/lib/auto-proxy.sh"

CONFIGS_DIR="$SCRIPT_DIR/data/chromego_configs"
CONFIG_JSON="$CONFIGS_DIR/config.json"
YAML="$SCRIPT_DIR/data/config.yaml"
GEN_PY="$SCRIPT_DIR/lib/generate-config.py"
SINGBOX_BIN="${SINGBOX_BIN:-sing-box}"
SERVICE_NAME="sing-box-chromego"
PORT=1080
LISTEN="${LISTEN:-0.0.0.0}"
RULESET_DIR="/var/lib/sing-box/rule-set"

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; CYAN='\033[0;36m'; NC='\033[0m'
info()  { echo -e "${CYAN}$*${NC}"; }
ok()    { echo -e "  ${GREEN}✓${NC} $*"; }
warn()  { echo -e "  ${YELLOW}⚠${NC} $*" >&2; }
err()   { echo -e "  ${RED}✗${NC} $*" >&2; }

CRON_CMD="*/30 * * * * cd $SCRIPT_DIR && bash bin/_update-sources >/dev/null 2>&1"

# ═══════════════════════════════════════
# 辅助函数
# ═══════════════════════════════════════

install_cron() {
  if crontab -l 2>/dev/null | grep -qF "bin/_update-sources"; then
    ok "cron 已存在"; return
  fi
  (crontab -l 2>/dev/null || true; echo "$CRON_CMD") | crontab -
  ok "cron 已安装"
}

remove_cron() {
  crontab -l 2>/dev/null | grep -vF "bin/_update-sources" | crontab - || true
  ok "cron 已移除"
}

show_cron() {
  if crontab -l 2>/dev/null | grep -qF "bin/_update-sources"; then
    echo "cron: 已安装"; crontab -l 2>/dev/null | grep "bin/_update-sources"
  else
    echo "cron: 未安装"
  fi
}

count_nodes() {
  [ -f "$CONFIG_JSON" ] || { echo 0; return; }
  python3 -c "
import json
try:
    c = json.load(open('$CONFIG_JSON'))
    out = c.get('outbounds', [])
    nodes = [o for o in out if isinstance(o, dict) and o.get('type') in ('vless','vmess','trojan','ss','hysteria','hysteria2','tuic','direct')]
    print(len(nodes))
except: print(0)
" 2>/dev/null || echo 0
}

# ═══════════════════════════════════════
# Step 1: 前置检测
# ═══════════════════════════════════════

check_prereqs() {
  command -v python3 &>/dev/null || { err "需要 python3"; exit 1; }
  command -v curl &>/dev/null    || { err "需要 curl";   exit 1; }
  mkdir -p "$CONFIGS_DIR" "$RULESET_DIR"
}

install_singbox() {
  command -v "$SINGBOX_BIN" &>/dev/null && { ok "sing-box 已安装: $($SINGBOX_BIN version 2>&1 | head -1)"; return 0; }
  # 从官方脚本安装（适用于 systemd 和 Docker）
  info "安装 sing-box..."
  curl -fsSL https://sing-box.app/g.sh | bash -s -- -y 2>/dev/null || true
  if command -v "$SINGBOX_BIN" &>/dev/null; then
    ok "sing-box 已安装: $($SINGBOX_BIN version 2>&1 | head -1)"
  else
    err "sing-box 安装失败，请手动安装"
    exit 1
  fi
}

# ═══════════════════════════════════════
# Step 2: 规则集
# ═══════════════════════════════════════

setup_rulesets() {
  [ -f "$RULESET_DIR/geoip-cn.srs" ] && [ -f "$RULESET_DIR/geosite-cn.srs" ] && {
    ok "规则集已存在"; return 0
  }

  info "下载 geoip 数据库..."
  local geoip_db="/tmp/geoip.db" geosite_db="/tmp/geosite.db"
  curl -fsSL -o "$geoip_db" "https://github.com/SagerNet/sing-geoip/releases/latest/download/geoip.db" || {
    warn "geoip.db 下载失败"; return 1
  }
  info "下载 geosite 数据库..."
  curl -fsSL -o "$geosite_db" "https://github.com/SagerNet/sing-geosite/releases/latest/download/geosite.db" || {
    warn "geosite.db 下载失败"; return 1
  }

  info "导出规则集..."
  "$SINGBOX_BIN" -f "$geoip_db" geoip export cn -o "$RULESET_DIR/geoip-cn.srs" 2>/dev/null
  "$SINGBOX_BIN" geosite export cn -f "$geosite_db" -o "$RULESET_DIR/geosite-cn.srs" 2>/dev/null
  rm -f "$geoip_db" "$geosite_db"

  if [ -f "$RULESET_DIR/geoip-cn.srs" ] && [ -f "$RULESET_DIR/geosite-cn.srs" ]; then
    ok "规则集已生成 ($(du -sh "$RULESET_DIR" | cut -f1))"
  else
    warn "规则集生成失败，可能影响国内分流"
  fi
  return 0
}

# ═══════════════════════════════════════
# Step 3: 下载 & 生成配置
# ═══════════════════════════════════════

generate_config() {
  info "下载 ChromeGo 源..."
  bash "$SCRIPT_DIR/lib/source-chromego.sh" 2>&1 | tail -3 || true

  info "下载 Clash 源..."
  bash "$SCRIPT_DIR/bin/_fetch-clash" 2>&1 | tail -3 || true

  info "生成 sing-box 配置..."
  local py="$GEN_PY"
  if [ -f "$YAML" ]; then
    python3 "$py" --proxy-yaml "$YAML" --configs "$CONFIGS_DIR" \
      --output "$CONFIG_JSON" --listen "$LISTEN" --port "$PORT" || {
      python3 "$py" --configs "$CONFIGS_DIR" --output "$CONFIG_JSON" \
        --listen "$LISTEN" --port "$PORT" || true
    }
  else
    python3 "$py" --configs "$CONFIGS_DIR" --output "$CONFIG_JSON" \
      --listen "$LISTEN" --port "$PORT" || true
  fi

  local n
  n="$(count_nodes)"
  if [ "$n" -gt 0 ]; then
    ok "配置生成完成，节点数: $n"
  else
    warn "配置无可用节点（首次部署正常，下次 cron 会重试）"
  fi
}

# ═══════════════════════════════════════
# Step 4: 启动服务
# ═══════════════════════════════════════

start_service() {
  [ -f "$CONFIG_JSON" ] || { warn "配置不存在，跳过启动"; return 1; }

  if command -v systemctl &>/dev/null && [ "$(cat /proc/1/comm 2>/dev/null)" = "systemd" ]; then
    # ── systemd 环境 ──
    local service_file="/etc/systemd/system/${SERVICE_NAME}.service"
    if [ ! -f "$service_file" ]; then
      info "创建 systemd service..."
      sudo tee "$service_file" >/dev/null <<SERVICE
[Unit]
Description=Proxy Service (sing-box)
After=network.target

[Service]
Type=simple
ExecStart=$SINGBOX_BIN run -c $CONFIG_JSON
Restart=on-failure
RestartSec=10
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
SERVICE
      sudo systemctl daemon-reload
      sudo systemctl enable "$SERVICE_NAME"
    fi
    # 停止旧进程后重启（避免端口冲突）
    sudo systemctl stop "$SERVICE_NAME" 2>/dev/null || true
    sleep 1
    sudo systemctl start "$SERVICE_NAME" || {
      warn "systemctl 启动失败，尝试直接启动..."
      direct_start
      return
    }
    ok "sing-box systemd 服务已启动"
  else
    # ── 非 systemd 环境（Docker 容器等） ──
    direct_start
  fi
}

direct_start() {
  # 停掉旧的 sing-box 进程
  pkill sing-box 2>/dev/null || true
  for _ in 1 2 3 4 5; do
    pgrep sing-box >/dev/null 2>&1 || break
    sleep 1
  done

  nohup "$SINGBOX_BIN" run -c "$CONFIG_JSON" >/tmp/singbox.log 2>&1 &
  local pid=$!
  sleep 3
  if kill -0 "$pid" 2>/dev/null; then
    ok "sing-box 已启动 (PID $pid)"
  else
    err "sing-box 启动失败，日志:"
    tail -5 /tmp/singbox.log 2>/dev/null || true
    return 1
  fi
}

# ═══════════════════════════════════════
# Step 5: 容器自动启动（Docker 环境）
# ═══════════════════════════════════════

setup_docker_autostart() {
  # 检查是否在 Docker 容器内（没有 systemd 但有 /.dockerenv）
  [ -f "/.dockerenv" ] || return 0

  local start_script="/etc/sing-box-start.sh"
  if [ -f "$start_script" ]; then
    ok "容器启动脚本已存在"
    return 0
  fi

  info "创建容器启动脚本..."
  cat > "$start_script" <<SCRIPT
#!/usr/bin/env bash
# 容器启动时自动启动 sing-box
[ -f "$CONFIG_JSON" ] || exit 0
nohup $SINGBOX_BIN run -c $CONFIG_JSON >/tmp/singbox.log 2>&1 &
SCRIPT
  chmod +x "$start_script"

  # 注入到 .bashrc 或 profile（容器 SSH 登录时触发）
  local injected=false
  for rc in /root/.bashrc /home/*/.bashrc; do
    [ -f "$rc" ] || continue
    if ! grep -qF "sing-box-start" "$rc" 2>/dev/null; then
      echo "[ -x /etc/sing-box-start.sh ] && /etc/sing-box-start.sh 2>/dev/null || true" >> "$rc"
      injected=true
    fi
  done
  if [ "$injected" = true ]; then
    ok "容器自动启动已配置"
  else
    ok "容器启动脚本已创建"
  fi
}

# ═══════════════════════════════════════
# Main
# ═══════════════════════════════════════

main() {
  case "${1:-}" in
    -h|--help) head -15 "$0"; exit 0 ;;
    --install-cron) install_cron; exit 0 ;;
    --remove-cron) remove_cron; exit 0 ;;
    --show-cron) show_cron; exit 0 ;;
  esac

  echo ""
  echo "══════════════════════════════════════"
  info "  proxy-deploy — 一键部署"
  echo "══════════════════════════════════════"
  echo ""

  check_prereqs

  echo "[1/5] 检测 sing-box..."
  install_singbox

  echo ""
  echo "[2/5] 准备 geoip/geosite 规则集..."
  setup_rulesets

  echo ""
  echo "[3/5] 下载订阅源 & 生成配置..."
  generate_config

  echo ""
  echo "[4/5] 启动服务..."
  start_service

  echo ""
  echo "[5/5] 配置自动启动..."
  setup_docker_autostart

  # 仅在 systemd 环境安装 cron
  if command -v systemctl &>/dev/null && [ "$(cat /proc/1/comm 2>/dev/null)" = "systemd" ]; then
    install_cron
  fi

  echo ""
  ok "部署完成"
  info "  连接: socks5h://127.0.0.1:${PORT}"
  info "  Dashboard: http://${LISTEN}:9090/ui"
  info "  测试: proxy-test"
  info "  添加订阅: proxy-sub <url>"
}

main "$@"
