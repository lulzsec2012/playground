#!/usr/bin/env bash
# proxy-sub — 手动添加订阅链接到代理源
#
# 从指定 URL 下载 Clash 订阅，验证后加入 custom-sources.list，
# 合并到现有配置中，重启 sing-box。
#
# 用法:
#   proxy-sub <url>           # 添加订阅并部署
#   proxy-sub <url> --dry-run # 只下载验证，不部署
#   proxy-sub --list          # 查看已添加的自定义订阅

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
source "$SCRIPT_DIR/lib/auto-proxy.sh"

CUSTOM_LIST="$SCRIPT_DIR/data/custom-sources.list"
CONFIGS_DIR="$SCRIPT_DIR/data/chromego_configs"
CONFIG_JSON="$CONFIGS_DIR/config.json"
TMPDIR=""
DRY_RUN=false

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
info()  { echo -e "${CYAN}$1${NC}"; }
ok()    { echo -e "  ${GREEN}✓${NC} $1"; }
warn()  { echo -e "  ${YELLOW}⚠${NC} $1" >&2; }
err()   { echo -e "  ${RED}✗${NC} $1" >&2; }

usage() { sed -n 's/^# *//p' "$0" | sed '1,2d'; exit 0; }

cleanup() { rm -rf "$TMPDIR"; }

# ── URL 已存在？ ──
url_exists() {
  local url="$1"
  [ -f "$CUSTOM_LIST" ] || return 1
  while IFS= read -r line; do
    line="${line%%#*}"
    line="${line//[[:space:]]/}"
    [ "$line" = "$url" ] && return 0
  done < "$CUSTOM_LIST"
  return 1
}

# ── 下载并验证 ──
download_url() {
  local url="$1" outfile="$2"

  if [ -n "${PROXY_LIST:-}" ]; then
    while IFS= read -r proxy; do
      [ -z "$proxy" ] && continue
      local sc="${proxy%%://*}" ad="${proxy#*://}"
      local code
      code="$(curl -sL -o "$outfile" -w "%{http_code}" \
        --connect-timeout 10 --max-time 30 \
        -x "${sc}://${ad}" "$url" 2>/dev/null || true)"
      if [ "$code" = "200" ] && [ -s "$outfile" ]; then
        return 0
      fi
    done <<< "$PROXY_LIST"
  fi

  # 直连 fallback
  local code
  code="$(curl -sL -o "$outfile" -w "%{http_code}" \
    --connect-timeout 10 --max-time 30 "$url" 2>/dev/null || true)"
  [ "$code" = "200" ] && [ -s "$outfile" ] && return 0

  rm -f "$outfile"
  return 1
}

# ── 验证 Clash YAML ──
is_valid_yaml() {
  local file="$1"
  [ -s "$file" ] || return 1
  grep -q '^proxies:' "$file" 2>/dev/null || return 1
  grep -q '^- name:' "$file" 2>/dev/null || return 1
  return 0
}

# ── 添加到 custom-sources.list ──
add_to_list() {
  local url="$1"
  [ -f "$CUSTOM_LIST" ] && printf '\n' >> "$CUSTOM_LIST"
  echo "$url" >> "$CUSTOM_LIST"
}

main() {
  [[ $# -eq 0 ]] && usage

  local SUB_URL="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage ;;
      --dry-run) DRY_RUN=true; shift ;;
      *) echo "未知: $1"; exit 1 ;;
    esac
  done

  if [[ "$1" == "--list" ]]; then
    if [ -f "$CUSTOM_LIST" ] && [ -s "$CUSTOM_LIST" ]; then
      echo "自定义订阅:"
      cat "$CUSTOM_LIST"
    else
      echo "无自定义订阅"
    fi
    exit 0
  fi

  SUB_URL="$1"
  TMPDIR="$(mktemp -d)"
  trap cleanup EXIT

  auto_detect_proxies || true

  # 1. 去重
  if url_exists "$SUB_URL"; then
    warn "此 URL 已存在: $SUB_URL"
    exit 1
  fi

  # 2. 下载
  echo "下载: $SUB_URL"
  local tmpfile="$TMPDIR/sub.yaml"
  if ! download_url "$SUB_URL" "$tmpfile"; then
    err "下载失败"
    exit 1
  fi

  if ! is_valid_yaml "$tmpfile"; then
    err "文件不包含有效代理"
    exit 1
  fi

  local node_count
  node_count="$(grep -c '^- name:' "$tmpfile" 2>/dev/null || echo 0)"
  ok "下载成功，含 ${node_count} 个节点"

  [ "$DRY_RUN" = true ] && { echo "DRY RUN — 跳过部署"; exit 0; }

  # 3. 添加到列表
  add_to_list "$SUB_URL"
  ok "已添加到 custom-sources.list"

  # 4. 重新合并
  echo "重跑 _fetch-clash..."
  bash "$SCRIPT_DIR/bin/_fetch-clash" || true

  # 5. 生成配置 + 重启
  echo "生成配置..."
  python3 "$SCRIPT_DIR/lib/generate-config.py" \
    --proxy-yaml "$SCRIPT_DIR/data/config.yaml" \
    --configs "$CONFIGS_DIR" \
    --output "$CONFIG_JSON" || {
    warn "配置生成失败"
    exit 1
  }

  if command -v systemctl &>/dev/null; then
    echo "重启 sing-box..."
    sudo systemctl restart sing-box 2>/dev/null || \
    sudo systemctl restart sing-box-chromego 2>/dev/null || true
    ok "已重启"
  fi

  ok "完成: $SUB_URL 已添加"
}

main "$@"
