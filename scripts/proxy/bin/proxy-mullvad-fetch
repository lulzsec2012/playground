#!/usr/bin/env bash
# proxy-mullvad-fetch — 自动拉取 Mullvad WireGuard 配置
#
# 通过 Mullvad API 自动下载指定区域的 WireGuard 配置文件。
# 需要提供 Mullvad 账号号 (Account Number)。
#
# 用法:
#   proxy-mullvad-fetch --account 1234567890123456
#   proxy-mullvad-fetch --account 1234567890123456 --regions us-lax,us-nyc,sg,jp
#   proxy-mullvad-fetch --account 1234567890123456 --all
#   proxy-mullvad-fetch --list                         # 列出可用区域
#   proxy-mullvad-fetch --help
#
# 环境变量:
#   MULLVAD_ACCOUNT         — Mullvad 账号号 (替代 --account)
#   MULLVAD_CONF_DIR        — 配置输出目录 (默认: ../data/mullvad 相对于脚本位置)
#
# API 参考:
#   https://api.mullvad.net/www/

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CONF_DIR="${MULLVAD_CONF_DIR:-$SCRIPT_DIR/data/mullvad}"
API_BASE="https://api.mullvad.net/www"
USER_AGENT="playground-proxy/1.0"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
info()  { echo -e "${CYAN}$*${NC}"; }
ok()    { echo -e "  ${GREEN}✓${NC} $*"; }
warn()  { echo -e "  ${YELLOW}⚠${NC} $*" >&2; }
err()   { echo -e "  ${RED}✗${NC} $*" >&2; }

# ── 辅助函数 ──────────────────────────────────

usage() {
  sed -n '2,16p' "$0" | sed 's/^#//; s/^ //'
  exit 0
}

# ── 检查依赖 ──────────────────────────────────

command -v curl &>/dev/null || { err "需要 curl"; exit 1; }

# ── 获取可用服务器列表 (含城市/国家信息) ────────

fetch_server_list() {
  local api_key="${1:-}"
  local auth_header=""
  [[ -n "$api_key" ]] && auth_header="Authorization: Bearer $api_key"

  curl -sS --max-time 15 \
    -H "$USER_AGENT" \
    ${auth_header:+-H "$auth_header"} \
    "$API_BASE/relays/all/" 2>/dev/null || {
    err "无法获取服务器列表，请检查网络连接"
    return 1
  }
}

# ── 按区域名称筛选服务器 ──────────────────────

list_available_regions() {
  local api_key="${1:-}"
  info "正在获取 Mullvad 可用服务器列表..."
  local data
  data=$(fetch_server_list "$api_key") || return 1

  echo ""
  info "可用区域 (国家/城市):"
  echo "────────────────────────────────────────────────────"
  echo "$data" | python3 -c "
import json, sys
data = json.load(sys.stdin)
seen = set()
for relay in data.get('wireguard', []):
    country = relay.get('country_name', '?')
    city = relay.get('city_name', '?')
    hostname = relay.get('hostname', '')
    # 取城市级代码: us-los-angeles → us-lax
    code = relay.get('city_code', '')
    key = (country, city)
    if key not in seen:
        seen.add(key)
        print(f'  {country:20s} {city:25s} code={code}')
print(f'\n共 {len(seen)} 个城市地区')
" 2>/dev/null || {
    warn "解析失败，原始数据格式可能已变更"
    echo "$data" | head -c 500
  }
}

# ── 下载指定区域的 WireGuard 配置 ──────────────

download_config() {
  local account="$1"
  local hostname="$2"  # 例如: us-los-angeles-wg-001
  local output_dir="$3"

  local output_file="$output_dir/mullvad-${hostname}.conf"
  local tmp_file
  tmp_file=$(mktemp)

  # Mullvad WireGuard 配置 API
  # URL: https://api.mullvad.net/www/wireguard/<account>/<hostname>/
  local url="$API_BASE/wireguard/$account/$hostname/"

  local http_code
  http_code=$(curl -sS --max-time 20 \
    -H "$USER_AGENT" \
    -o "$tmp_file" \
    -w "%{http_code}" \
    "$url" 2>/dev/null || echo "000")

  if [[ "$http_code" != "200" ]]; then
    local error_msg
    error_msg=$(cat "$tmp_file" 2>/dev/null || true)
    rm -f "$tmp_file"
    if [[ "$http_code" == "401" ]] || [[ "$http_code" == "403" ]]; then
      err "认证失败 (HTTP $http_code): 请检查账号号是否正确"
    elif [[ "$http_code" == "404" ]]; then
      err "配置未找到 (HTTP $http_code): hostname=$hostname"
    else
      err "下载失败 (HTTP $http_code): $error_msg"
    fi
    return 1
  fi

  # 验证文件内容是否为有效的 WireGuard 配置
  if ! grep -q "^\[Interface\]" "$tmp_file" 2>/dev/null; then
    err "下载的文件不是有效的 WireGuard 配置: $hostname"
    rm -f "$tmp_file"
    return 1
  fi

  mv "$tmp_file" "$output_file"
  ok "已下载: $output_file"
  return 0
}

# ── 主逻辑 ──────────────────────────────────

main() {
  local account=""
  local specific_regions=""
  local download_all=false
  local list_only=false

  # 解析参数
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --account) shift; account="$1" ;;
      --regions) shift; specific_regions="$1" ;;
      --all) download_all=true ;;
      --list) list_only=true ;;
      -h|--help) usage ;;
      *) err "未知参数: $1"; usage ;;
    esac
    shift
  done

  # 允许环境变量
  if [[ -z "$account" ]]; then
    account="${MULLVAD_ACCOUNT:-}"
  fi

  # 仅列出可用区域
  if $list_only; then
    list_available_regions "$account"
    exit $?
  fi

  # 下载模式: 需要账号
  if [[ -z "$account" ]]; then
    err "需要提供 Mullvad 账号号"
    echo "  方式1: proxy-mullvad-fetch --account 1234567890123456"
    echo "  方式2: export MULLVAD_ACCOUNT=1234567890123456"
    exit 1
  fi

  # 确保输出目录存在
  mkdir -p "$CONF_DIR"

  echo "Mullvad WireGuard Config Fetcher"
  echo "  Account:  $account"
  echo "  Output:   $CONF_DIR"
  echo ""

  if $download_all; then
    # 下载所有可用区域
    info "正在获取服务器列表..."
    local data
    data=$(fetch_server_list) || exit 1

    local count=0
    local errors=0

    # 从 API 解析所有 wireguard 主机名
    while IFS= read -r hostname; do
      if download_config "$account" "$hostname" "$CONF_DIR"; then
        ((count++))
      else
        ((errors++))
      fi
    done < <(echo "$data" | python3 -c "
import json, sys
data = json.load(sys.stdin)
for relay in data.get('wireguard', []):
    hostname = relay.get('hostname', '')
    if hostname:
        print(hostname)
" 2>/dev/null)

    echo ""
    ok "完成: 成功 $count, 失败 $errors"

  elif [[ -n "$specific_regions" ]]; then
    # 下载指定区域
    IFS=',' read -ra regions <<< "$specific_regions"
    info "正在获取服务器列表以查找区域..."
    local data
    data=$(fetch_server_list) || exit 1

    local count=0
    local errors=0

    for region in "${regions[@]}"; do
      region=$(echo "$region" | xargs)  # trim
      info "  搜索区域: $region"

      # 在 API 结果中查找匹配的主机名
      local hostnames
      hostnames=$(echo "$data" | python3 -c "
import json, sys
data = json.load(sys.stdin)
target = '$region'
for relay in data.get('wireguard', []):
    cc = relay.get('city_code', '') or relay.get('city_name', '')
    hostname = relay.get('hostname', '')
    if target.lower() in cc.lower() and hostname:
        print(hostname)
" 2>/dev/null)

      if [[ -z "$hostnames" ]]; then
        warn "未找到区域 '$region' 的服务器"
        ((errors++))
        continue
      fi

      # 每个区域只下载第一个主机
      first_host=$(echo "$hostnames" | head -1)
      if download_config "$account" "$first_host" "$CONF_DIR"; then
        ((count++))
      else
        ((errors++))
      fi
    done

    echo ""
    ok "完成: 成功 $count, 失败 $errors"
    if [[ $errors -gt 0 ]]; then
      echo "  提示: 使用 --list 参数查看可用区域代码"
    fi
  else
    # 默认: 尝试根据 mullvad-regions.yaml 下载
    local regions_yaml="$SCRIPT_DIR/config/mullvad-regions.yaml"
    if [[ -f "$regions_yaml" ]]; then
      info "从 $regions_yaml 读取区域配置..."

      local region_keys
      region_keys=$(python3 -c "
import yaml, sys
with open('$regions_yaml') as f:
    data = yaml.safe_load(f)
if data and 'regions' in data:
    print(' '.join(data['regions'].keys()))
" 2>/dev/null || true)

      if [[ -n "$region_keys" ]]; then
        info "配置中定义的区域: $region_keys"
        # 转换为逗号分隔并递归调用
        region_csv=$(echo "$region_keys" | tr ' ' ',')
        exec "$0" --account "$account" --regions "$region_csv"
      fi
    fi

    # 如果还没有区域配置，提示用户
    err "未指定区域。请使用以下方式之一:"
    echo "  proxy-mullvad-fetch --account <账号> --all              # 下载所有区域"
    echo "  proxy-mullvad-fetch --account <账号> --regions us-lax,sg,jp  # 下载指定区域"
    echo "  proxy-mullvad-fetch --list                             # 查看可用区域"
    echo ""
    echo "  或者先编辑 $SCRIPT_DIR/config/mullvad-regions.yaml 添加区域"
    exit 1
  fi
}

main "$@"
